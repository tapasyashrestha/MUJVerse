# ─────────────────────────────────────────────────────────
#  MUJVERSE — .gitignore
# ─────────────────────────────────────────────────────────

# Environment and secrets — NEVER commit these
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual environments
venv/
.venv/
env/
ENV/
.virtualenv/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
mujverse/media/*
!mujverse/media/.gitkeep
mujverse/static/collected/
staticfiles/

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Node (for academic modules)
academic_modules/node_demo/node_modules/
academic_modules/*/node_modules/

# Coverage and test artifacts
.coverage
htmlcov/
.pytest_cache/
.tox/

# Distribution
*.tar.gz
*.zip
